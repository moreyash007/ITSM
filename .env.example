# Copy to .env and fill in. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=helpdesk.example.com
CSRF_TRUSTED_ORIGINS=https://helpdesk.example.com

POSTGRES_DB=itsm_db
POSTGRES_USER=itsm_user
POSTGRES_PASSWORD=

# Password for the initial "admin" account (created on first start only)
ADMIN_PASSWORD=

# Email (leave EMAIL_BACKEND as console to just log emails)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=helpdesk@example.com
